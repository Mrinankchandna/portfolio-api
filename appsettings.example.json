{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=your_server;Database=your_database;User=your_user;Password=your_password;Port=your_port;SslMode=Required;AllowUserVariables=true;ConnectionTimeout=30;DefaultCommandTimeout=30;"
  },
  "Twilio": {
    "AccountSid": "your_twilio_account_sid",
    "AuthToken": "your_twilio_auth_token",
    "FromNumber": "whatsapp:+your_from_number",
    "ToNumber": "whatsapp:+your_to_number"
  }
}